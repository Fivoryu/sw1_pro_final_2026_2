# Copy to .env and provide environment-specific values.
JWT_SECRET=replace-with-a-local-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SESSION_INACTIVITY_MINUTES=30

# Required only for live database operations and Alembic online mode.
DATABASE_URL=
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16
APP_ENV=development

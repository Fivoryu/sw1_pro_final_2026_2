FROM node:22-bookworm-slim

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY . .
# Git for Windows may check out the entrypoint with CRLF; normalize it before /bin/sh runs it.
RUN sed -i 's/\r$//' docker-local-node.sh

CMD ["sh", "./docker-local-node.sh"]

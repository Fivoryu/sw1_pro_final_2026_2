# Valores ficticios para desarrollo local; no usar credenciales reales.
POSTGRES_DB=roomforge_local
POSTGRES_USER=roomforge_local
POSTGRES_PASSWORD=local-postgres-only
POSTGRES_PORT=5434
FLOCI_PORT=4566
API_PORT=8000
PANEL_PORT=5173
# Stripe test-mode only. Replace locally; never commit real keys.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_cli_secret
STRIPE_CONNECT_ACCOUNT_COUNTRY=US
# Bind addresses: 0.0.0.0 enables external devices (e.g. mobile phone on Wi-Fi), 127.0.0.1 restricts to loopback.
API_BIND_ADDRESS=0.0.0.0
HARDHAT_BIND_ADDRESS=0.0.0.0
FLOCI_BIND_ADDRESS=0.0.0.0
PANEL_BIND_ADDRESS=0.0.0.0
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_SECONDS=10
STAFF_EMAIL_SEND_TIMEOUT_SECONDS=10

# Development-only application secrets; replace before any non-local use.
JWT_SECRET=roomforge-local-only-jwt-secret-do-not-use-outside-development
STAFF_TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FLOCI_STORAGE_MODE=persistent
FLOCI_STORAGE_PERSISTENT_PATH=/app/data
FLOCI_ENDPOINT_URL=http://127.0.0.1:4566
AWS_DEFAULT_REGION=us-east-1

# Local-only resources and endpoints for applications on the Compose network.
S3_BUCKET_NAME=roomforge-local-assets
SQS_QUEUE_NAME=roomforge-local-events
S3_ENDPOINT_URL=http://floci:4566
# Address that signed photo links use. The API reaches Floci at S3_ENDPOINT_URL,
# while the panel and the emulator (through `adb reverse tcp:4566 tcp:4566`) use this one.
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:4566
SQS_ENDPOINT_URL=http://floci:4566

# Local Hardhat API/network configuration; values match deploy-local.ts.
HARDHAT_PORT=8545
ROOMFORGE_ESCROW_RPC_URL=http://127.0.0.1:8545
ROOMFORGE_ESCROW_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
ROOMFORGE_ESCROW_BOB_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
ROOMFORGE_ESCROW_USD_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
ROOMFORGE_ESCROW_USDT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
ROOMFORGE_ESCROW_CHAIN_ID=31337
# Public, deterministic Hardhat test key. Never use this account on a public chain.
ROOMFORGE_ESCROW_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Explicitly enables the local-only F09 demo seed command.
ROOMFORGE_ALLOW_LOCAL_DEMO_SEED=true

# Flutter Android emulator dart-defines; supply a team Reown Project ID to flutter run.
ROOMFORGE_API_BASE_URL=http://10.0.2.2:8000
ROOMFORGE_HARDHAT_RPC_URL=http://10.0.2.2:8545
ROOMFORGE_RFT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ROOMFORGE_USDT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ROOMFORGE_REOWN_PROJECT_ID=
